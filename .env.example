# CareFlow Frontend Environment Variables
# Leave blank to use built-in mock data service with localStorage persistence.
# When your backend API is ready, set the API base URL below.

VITE_API_URL=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SESSION_STORAGE_KEY=careflow-auth

# Optional LLM integration for the health assistant chatbox
VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
VITE_LLM_API_KEY=your-llm-api-key
VITE_LLM_MODEL=gpt-4o-mini
